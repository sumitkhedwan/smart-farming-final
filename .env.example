APP_ENV=demo
MAX_UPLOAD_BYTES=10485760
MIN_IMAGE_SIDE=64
MAX_IMAGE_PIXELS=40000000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
FRONTEND_DIST=dist

# Supabase project settings. The publishable key is designed for browser use;
# protect every table with RLS. Never use a service-role or secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Vercel Functions have a 4.5 MB request body limit. Set this to 4194304 there.
VITE_MAX_UPLOAD_BYTES=10485760
